{
    "name": "explorer-mvs",
    "version": "3.0.6",
    "directories": {
        "test": "tests"
    },
    "dependencies": {
        "@material-ui/core": "4.12.4",
        "@material-ui/icons": "4.11.3",
        "immutable": "4.3.7",
        "orion-editor-component": "0.0.16",
        "prop-types": "15.8.1",
        "react": "16.14.0",
        "react-contextmenu": "2.10.0",
        "react-dom": "16.14.0",
        "react-redux": "5.1.1",
        "react-router": "5.3.4",
        "react-router-dom": "5.3.4",
        "redux": "4.0.4",
        "redux-immutable": "4.0.0",
        "redux-thunk": "2.3.0"
    },
    "devDependencies": {
        "@types/chai": "4.3.18",
        "@types/mocha": "10.0.7",
        "@types/node": "13.7.1",
        "@types/react": "16.9.56",
        "@types/selenium-webdriver": "4.1.26",
        "@typescript-eslint/eslint-plugin": "8.59.4",
        "@typescript-eslint/parser": "8.59.4",
        "c8": "11.0.0",
        "chai": "4.5.0",
        "compression-webpack-plugin": "11.1.0",
        "copy-webpack-plugin": "12.0.2",
        "css-loader": "7.1.2",
        "eslint": "8.57.0",
        "eslint-plugin-jsx-a11y": "6.9.0",
        "eslint-plugin-react": "7.35.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "expect": "29.7.0",
        "explorer-fvt-utilities": "2.0.4",
        "file-loader": "6.2.0",
        "html-webpack-plugin": "5.6.7",
        "mocha": "10.7.3",
        "mocha-jenkins-reporter": "0.4.8",
        "nock": "14.0.15",
        "redux-mock-store": "1.5.4",
        "selenium-webdriver": "4.23.0",
        "style-loader": "4.0.0",
        "terser-webpack-plugin": "5.3.10",
        "ts-loader": "9.5.7",
        "typescript": "5.7.3",
        "webpack": "5.94.0",
        "webpack-cli": "5.1.4",
        "webpack-dev-server": "5.2.4"
    },
    "scripts": {
        "dev": "webpack serve --config ./webpack.config.js --mode development --hot",
        "start": "OUTPUT_FOLDER='web' webpack --progress --color --watch --mode development",
        "lint": "eslint ./WebContent/js/ --ext .js,.ts,.tsx",
        "testWatch": "tsc -p tsconfig.test.json --watch & mocha --watch dist-test/tests/UnitTests --recursive",
        "test": "tsc -p tsconfig.test.json && JUNIT_REPORT_PATH=target/report.xml c8 mocha dist-test/tests/UnitTests --recursive --color --reporter mocha-jenkins-reporter",
        "test:fvt": "tsc -p tsconfig.test.json && NODE_TLS_REJECT_UNAUTHORIZED=0 JUNIT_REPORT_PATH=target/report-fvt.xml mocha --timeout 999999 dist-test/tests/FVTTests --recursive --color --reporter mocha-jenkins-reporter",
        "prod": "webpack --mode production",
        "preCommit": "npm run lint && npm run test && npm run prod"
    },
    "repository": "zowe/explorer-mvs",
    "browserslist": [
        "last 2 years"
    ],
    "description": "MVS Explorer",
    "author": "IBM",
    "license": "EPL-2.0",
    "c8": {
        "reporter": [
            "lcov",
            "cobertura",
            "text"
        ],
        "report-dir": "./coverage",
        "all": true,
        "include": [
            "dist-test/WebContent/js/actions/**",
            "dist-test/WebContent/js/reducers/**"
        ],
        "exclude": [
            "dist-test/tests",
            "WebContent/js/themes",
            "WebContent/js/resources/languages"
        ]
    }
}
